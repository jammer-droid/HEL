{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jammer-droid/HarnessEngineeringLab/evals/schema/record.schema.json",
  "title": "Run record (record-v0)",
  "description": "Collector output for one run. Field reference: evals/schema/record.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "harness", "model", "outcome", "usage", "events", "validity", "artifacts"],
  "properties": {
    "schema_version": { "const": "record-v0" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "experiment_id", "lab", "task_id", "condition", "repetition", "started_at", "ended_at"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "experiment_id": { "type": "string", "minLength": 1 },
        "lab": { "type": "string", "pattern": "^h[0-9]{2}$" },
        "task_id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "pattern": "^(baseline|variant(-[a-z0-9-]+)?|external-[a-z0-9-]+)$" },
        "repetition": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "comparison_class"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "comparison_class": { "enum": ["subject", "same-model", "reference"] }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "requested", "actual", "params"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "requested": { "type": "string", "minLength": 1 },
        "actual": { "type": ["string", "null"] },
        "params": { "type": "object" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_output", "termination", "error"],
      "properties": {
        "final_output": { "type": ["string", "null"] },
        "termination": { "enum": ["completed", "max_turns", "max_output_tokens", "timeout", "error"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "model_calls", "wall_time_ms"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/metric" },
        "output_tokens": { "$ref": "#/$defs/metric" },
        "model_calls": { "$ref": "#/$defs/metric" },
        "wall_time_ms": { "$ref": "#/$defs/metric" },
        "cached_input_tokens": { "$ref": "#/$defs/metric" },
        "peak_context_tokens": { "$ref": "#/$defs/metric" },
        "last_context_tokens": { "$ref": "#/$defs/metric" }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool_event" }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "reasons"],
      "properties": {
        "valid": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_transcript"],
      "properties": {
        "raw_transcript": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "status": { "enum": ["measured", "unavailable", "derived"] }
      },
      "if": { "properties": { "status": { "const": "unavailable" } } },
      "then": { "properties": { "value": { "type": "null" } } },
      "else": { "properties": { "value": { "type": "number" } } }
    },
    "tool_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "category", "name", "args", "ok"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["read", "search", "edit", "exec", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "args": { "type": "object" },
        "ok": { "type": ["boolean", "null"] }
      }
    }
  }
}
